/#
@summary The contract between Kiwi web applications and the server that runs them, in the
         spirit of Ruby's Rack. An app is anything callable with an environment hashmap that
         returns `[status, headers, body]`; middleware is a function from one app to another.
         The package provides the server, a builder for composing middleware and mounting apps,
         request and response helpers, stock middleware, and a test client that calls an app
         without a network.
#/
package web

  const VERSION = "1.0"

  _MIME = {
    "html":  "text/html; charset=utf-8",
    "htm":   "text/html; charset=utf-8",
    "xhtml": "application/xhtml+xml",
    "css":   "text/css; charset=utf-8",
    "js":    "text/javascript; charset=utf-8",
    "mjs":   "text/javascript; charset=utf-8",
    "json":  "application/json",
    "map":   "application/json",
    "xml":   "application/xml",
    "txt":   "text/plain; charset=utf-8",
    "md":    "text/markdown; charset=utf-8",
    "csv":   "text/csv; charset=utf-8",
    "png":   "image/png",
    "jpg":   "image/jpeg",
    "jpeg":  "image/jpeg",
    "gif":   "image/gif",
    "webp":  "image/webp",
    "avif":  "image/avif",
    "svg":   "image/svg+xml",
    "ico":   "image/x-icon",
    "bmp":   "image/bmp",
    "tiff":  "image/tiff",
    "woff":  "font/woff",
    "woff2": "font/woff2",
    "ttf":   "font/ttf",
    "otf":   "font/otf",
    "eot":   "application/vnd.ms-fontobject",
    "pdf":   "application/pdf",
    "zip":   "application/zip",
    "gz":    "application/gzip",
    "tar":   "application/x-tar",
    "mp4":   "video/mp4",
    "webm":  "video/webm",
    "ogg":   "video/ogg",
    "avi":   "video/x-msvideo",
    "mp3":   "audio/mpeg",
    "wav":   "audio/wav",
    "flac":  "audio/flac",
    "wasm":  "application/wasm"
  }

  _STATUS = {
    100: "Continue",
    101: "Switching Protocols",
    200: "OK",
    201: "Created",
    202: "Accepted",
    204: "No Content",
    206: "Partial Content",
    301: "Moved Permanently",
    302: "Found",
    303: "See Other",
    304: "Not Modified",
    307: "Temporary Redirect",
    308: "Permanent Redirect",
    400: "Bad Request",
    401: "Unauthorized",
    403: "Forbidden",
    404: "Not Found",
    405: "Method Not Allowed",
    406: "Not Acceptable",
    408: "Request Timeout",
    409: "Conflict",
    410: "Gone",
    413: "Content Too Large",
    415: "Unsupported Media Type",
    422: "Unprocessable Content",
    429: "Too Many Requests",
    500: "Internal Server Error",
    501: "Not Implemented",
    502: "Bad Gateway",
    503: "Service Unavailable",
    504: "Gateway Timeout"
  }

  # ---------------------------------------------------------------------------
  # Small utilities
  # ---------------------------------------------------------------------------

  /#
  @summary Returns the MIME type for a file extension, with or without its leading dot.
  @param string ext : The extension, such as `"png"` or `".png"`.
  @return string : The MIME type, or `"application/octet-stream"` when unknown.
  #/
  fn mime_type(ext)
    e = ext.lowercase()
    e = e[1:] when e.begins_with(".")
    _MIME.get(e, "application/octet-stream")
  end

  /#
  @summary Returns the reason phrase for an HTTP status code.
  @param integer code : The status code.
  @return string : The phrase, such as `"Not Found"`, or `""` when unknown.
  #/
  fn status_text(code)
    _STATUS.get(code, "")
  end

  /#
  @summary Parses `application/x-www-form-urlencoded` text, as found in query strings and form bodies. A `+` decodes to a space. When a key repeats, the last value wins.
  @param string text : The encoded text, without a leading `?`.
  @return hashmap : The decoded keys and values.
  #/
  fn parse_query(text)
    result = {}
    for pair in _pairs(text) do
      result[pair[0]] = pair[1]
    end
    result
  end

  /#
  @summary Parses `application/x-www-form-urlencoded` text into a list of `[key, value]` pairs, keeping every value of a repeated key in order.
  @param string text : The encoded text, without a leading `?`.
  @return list : The decoded pairs.
  #/
  fn parse_query_pairs(text)
    pairs = []
    for pair in _pairs(text) do
      pairs.push(pair)
    end
    pairs
  end

  fn _pairs(text)
    return when text == null || text == ""
    for part in text.split("&") do
      next when part == ""
      eq = part.index("=")
      if eq >= 0
        yield [http::url_decode(part[0:eq]), http::url_decode(part[eq + 1:])]
      else
        yield [http::url_decode(part), ""]
      end
    end
  end

  /#
  @summary Parses a `Cookie` request header into a hashmap of names to values.
  @param string header : The header value, such as `"a=1; b=2"`.
  @return hashmap : The cookies.
  #/
  fn parse_cookies(header)
    result = {}
    return result when header == null || header == ""
    for part in header.split(";") do
      trimmed = part.trim()
      eq = trimmed.index("=")
      if eq > 0
        result[trimmed[0:eq].trim()] = trimmed[eq + 1:].trim()
      end
    end
    result
  end

  /#
  @summary Builds a `Set-Cookie` header value.
  @param string name : The cookie name.
  @param string value : The cookie value.
  @param hashmap options : Any of `path` (default `"/"`), `max_age` (seconds), `domain`, `http_only` (default `true`), `secure` (default `false`) and `same_site` (default `"Lax"`).
  @return string : The header value.
  #/
  fn cookie_header(name, value, options = {})
    parts = ["${name}=${value}", "Path=${options.get("path", "/")}"]
    parts.push("Max-Age=${options["max_age"]}") when options.get("max_age") != null
    parts.push("Domain=${options["domain"]}") when options.get("domain") != null
    parts.push("HttpOnly") when options.get("http_only", true)
    parts.push("Secure") when options.get("secure", false)
    same_site = options.get("same_site", "Lax")
    parts.push("SameSite=${same_site}") when same_site != null
    parts.join("; ")
  end

  /#
  @summary Adds a header to a response's headers, keeping any value already there: a second value turns the entry into a list, which sends one header line per value (as `set-cookie` needs).
  @param hashmap headers : The response headers to change.
  @param string name : The header name. Use lowercase.
  @param string value : The value to add.
  @return hashmap : `headers`, for chaining.
  #/
  fn add_header(headers, name, value)
    existing = headers.get(name)
    if existing == null
      headers[name] = value
    elsif typeof(existing) == list
      existing.push(value)
    else
      headers[name] = [existing, value]
    end
    headers
  end

  # ---------------------------------------------------------------------------
  # Response helpers
  # ---------------------------------------------------------------------------

  /#
  @summary Builds a plain-text response.
  @param string body : The text.
  @param integer status : The status code (default `200`).
  @param hashmap headers : Extra headers (default `{}`).
  @return list : `[status, headers, body]`.
  #/
  fn text_response(body, status = 200, headers = {})
    _respond_with(status, headers, "text/plain; charset=utf-8", body.to_string())
  end

  /#
  @summary Builds an HTML response.
  @param string body : The HTML.
  @param integer status : The status code (default `200`).
  @param hashmap headers : Extra headers (default `{}`).
  @return list : `[status, headers, body]`.
  #/
  fn html_response(body, status = 200, headers = {})
    _respond_with(status, headers, "text/html; charset=utf-8", body.to_string())
  end

  /#
  @summary Builds a JSON response.
  @param any value : The value to serialize.
  @param integer status : The status code (default `200`).
  @param hashmap headers : Extra headers (default `{}`).
  @return list : `[status, headers, body]`.
  #/
  fn json_response(value, status = 200, headers = {})
    _respond_with(status, headers, "application/json", serialize(value))
  end

  /#
  @summary Builds a redirect response.
  @param string location : Where to send the client.
  @param integer status : The status code (default `302`; use `301`, `303`, `307` or `308` as needed).
  @return list : `[status, headers, body]`.
  #/
  fn redirect(location, status = 302)
    [status, {"location": location}, ""]
  end

  /#
  @summary Builds a plain-text error response whose body is the status's reason phrase.
  @param integer status : The status code.
  @param string message : The body (default: the reason phrase, such as `"Not Found"`).
  @return list : `[status, headers, body]`.
  #/
  fn status_response(status, message = null)
    text_response(message ?? status_text(status), status)
  end

  fn _respond_with(status, headers, content_type, body)
    h = headers.clone()
    h["content-type"] = content_type when !h.has_key("content-type")
    [status, h, body]
  end

  # ---------------------------------------------------------------------------
  # Request
  # ---------------------------------------------------------------------------

  /#
  @summary A read-only view of an environment with parsing helpers. Parsed values are cached in the environment, so every `Request` made from the same environment shares them.
  #/
  struct Request
    /#
    @summary Wraps an environment.
    @param hashmap env : The environment passed to the app.
    #/
    fn new(env)
      @env = env
    end

    /#
    @summary Returns the environment.
    @return hashmap
    #/
    fn env()          @env end

    /#
    @summary Returns the HTTP method, uppercase.
    @return string
    #/
    fn method()       @env["method"] end

    /#
    @summary Returns the full path: `script_name` followed by `path_info`.
    @return string
    #/
    fn path()
      full = @env.get("script_name", "") + @env.get("path_info", "")
      full == "" ? "/" : full
    end

    /#
    @summary Returns the part of the path after the point where the app is mounted.
    @return string
    #/
    fn path_info()    @env.get("path_info", "") end

    /#
    @summary Returns the path where the app is mounted, or `""` at the root.
    @return string
    #/
    fn script_name()  @env.get("script_name", "") end

    /#
    @summary Returns the raw query string, without the `?`.
    @return string
    #/
    fn query_string() @env.get("query_string", "") end

    /#
    @summary Returns the query string parsed into a hashmap. When a key repeats, the last value wins; use `query_all` for every value.
    @return hashmap
    #/
    fn query()
      @env["web.query"] = parse_query(@.query_string()) when !@env.has_key("web.query")
      @env["web.query"]
    end

    /#
    @summary Returns one query parameter.
    @param string name : The parameter name.
    @param any fallback : The value when it is absent (default `null`).
    @return any
    #/
    fn query_param(name, fallback = null)
      @.query().get(name, fallback)
    end

    /#
    @summary Returns every value of a query parameter, in order.
    @param string name : The parameter name.
    @return list
    #/
    fn query_all(name)
      values = []
      for pair in parse_query_pairs(@.query_string()) do
        values.push(pair[1]) when pair[0] == name
      end
      values
    end

    /#
    @summary Returns the request headers. Names are lowercase.
    @return hashmap
    #/
    fn headers()      @env.get("headers", {}) end

    /#
    @summary Returns a request header, or `null`. The name is case-insensitive.
    @param string name : The header name.
    @return string
    #/
    fn header(name)   @.headers().get(name.lowercase()) end

    /#
    @summary Returns the `Content-Type` header, or `""`.
    @return string
    #/
    fn content_type() @.header("content-type") ?? "" end

    /#
    @summary Checks whether the body is JSON.
    @return boolean
    #/
    fn is_json()      @.content_type().contains("application/json") end

    /#
    @summary Checks whether the body is a URL-encoded form.
    @return boolean
    #/
    fn is_form()      @.content_type().contains("application/x-www-form-urlencoded") end

    /#
    @summary Returns the body as bytes.
    @return bytes
    #/
    fn body_bytes()
      b = @env.get("body")
      b == null ? "".to_bytes() : b
    end

    /#
    @summary Returns the body decoded as UTF-8 text.
    @return string
    #/
    fn body()         @.body_bytes().to_string() end

    /#
    @summary Returns the body parsed as JSON, or `null` when it is empty.
    @return any
    #/
    fn json()
      if !@env.has_key("web.json")
        b = @.body()
        @env["web.json"] = b == "" ? null : deserialize(b)
      end
      @env["web.json"]
    end

    /#
    @summary Returns the fields of a URL-encoded form body.
    @return hashmap
    #/
    fn form()
      @env["web.form"] = parse_query(@.body()) when !@env.has_key("web.form")
      @env["web.form"]
    end

    /#
    @summary Returns the request cookies.
    @return hashmap
    #/
    fn cookies()
      @env["web.cookies"] = parse_cookies(@.header("cookie")) when !@env.has_key("web.cookies")
      @env["web.cookies"]
    end

    /#
    @summary Returns a cookie's value, or `null`.
    @param string name : The cookie name.
    @return string
    #/
    fn cookie(name)   @.cookies().get(name) end

    /#
    @summary Returns the client's IP address.
    @return string
    #/
    fn remote_addr()  @env.get("remote_addr", "") end

    /#
    @summary Returns `"http"` or `"https"`.
    @return string
    #/
    fn scheme()       @env.get("scheme", "http") end

    /#
    @summary Returns the host the client asked for: the `Host` header, or the server name and port.
    @return string
    #/
    fn host()         @.header("host") ?? "${@env.get("server_name", "localhost")}:${@env.get("server_port", 80)}" end

    /#
    @summary Returns the full URL of the request.
    @return string
    #/
    fn url()
      qs = @.query_string()
      "${@.scheme()}://${@.host()}${@.path()}" + (qs == "" ? "" : "?" + qs)
    end

    /#
    @summary Returns any environment value, such as one a middleware added.
    @param string key : The key, such as `"web.request_id"`.
    @param any fallback : The value when it is absent (default `null`).
    @return any
    #/
    fn get(key, fallback = null) @env.get(key, fallback) end
  end

  # ---------------------------------------------------------------------------
  # Builder
  # ---------------------------------------------------------------------------

  /#
  @summary Composes middleware and apps into one app. Middleware runs in the order it was added, so the first `use` sees each request first. A builder is itself an app.
  #/
  struct Builder
    fn new()
      @middleware = []
      @maps       = []
      @endpoint   = null
      @built      = null
    end

    /#
    @summary Adds a middleware: a function that takes the next app and returns a new app.
    @param lambda middleware : The middleware.
    @return Builder : self
    #/
    fn use(middleware)
      @middleware.push(middleware)
      @built = null
      @
    end

    /#
    @summary Sets the app that handles requests no mapping claims.
    @param any app : The app.
    @return Builder : self
    #/
    fn run(app)
      @endpoint = app
      @built = null
      @
    end

    /#
    @summary Mounts an app under a path prefix. The mounted app sees the prefix moved from `path_info` to `script_name`. The longest matching prefix wins, and a prefix only matches whole path segments.
    @param string prefix : The prefix, such as `"/api"`.
    @param any app : The app to mount (another builder works too).
    @return Builder : self
    #/
    fn map(prefix, app)
      p = prefix
      p = "/" + p when !p.begins_with("/")
      p = p[0:p.size() - 1] when p.size() > 1 && p.ends_with("/")
      @maps.push([p, app])
      @built = null
      @
    end

    /#
    @summary Builds the composed app. Calling the builder directly does this once, on the first request.
    @return lambda : The app.
    #/
    fn to_app()
      inner = @endpoint
      inner = _url_map(@maps, @endpoint) when @maps.size() > 0
      throw error::ValueError("web::Builder has no app: call run() or map() first") when inner == null
      for mw in @middleware.reverse() do
        inner = mw(inner)
        throw error::ValueError("web::Builder: a middleware returned null instead of an app") when inner == null
      end
      inner
    end

    /#
    @summary Handles a request, which makes a builder usable as an app.
    @param hashmap env : The environment.
    @return list : `[status, headers, body]`.
    #/
    fn call(env)
      @built = to_app() when @built == null
      @built(env)
    end
  end

  /#
  @summary Creates a `Builder`.
  @return Builder
  #/
  fn builder()
    Builder.new()
  end

  fn _url_map(maps, fallback)
    # Longest prefix first, so /api/v2 wins over /api.
    ordered = maps.sort(do (a, b) => a[0].size() > b[0].size())
    with (env) do
      path_info = env.get("path_info", "")
      for entry in ordered do
        prefix = entry[0]
        matched = prefix == "/" || path_info == prefix || path_info.begins_with(prefix + "/")
        next when !matched
        script_name = env.get("script_name", "")
        env["script_name"] = script_name + (prefix == "/" ? "" : prefix)
        env["path_info"]   = prefix == "/" ? path_info : path_info[prefix.size():]
        try
          return entry[1](env)
        finally
          env["script_name"] = script_name
          env["path_info"]   = path_info
        end
      end
      fallback == null ? status_response(404) : fallback(env)
    end
  end

  # ---------------------------------------------------------------------------
  # Middleware
  # ---------------------------------------------------------------------------

  /#
  @summary Logs each request to stderr after it is answered.
  @param string format : `"combined"` (client, time, request line, status, duration) or `"simple"` (time, request line, status, duration).
  @return lambda : The middleware.
  #/
  fn logger(format = "combined")
    with (app) do
      with (env) do
        started  = time::ticks()
        response = app(env)
        elapsed  = time::ticksms(time::ticks() - started).to_string("f2")
        req      = Request.new(env)
        status   = typeof(response) == list && response.size() > 0 ? response[0] : "-"
        if format == "simple"
          eprintln "[${time::timestamp()}] ${req.method()} ${req.path()} ${status} ${elapsed}ms"
        else
          eprintln "${req.remote_addr()} - [${time::timestamp()}] \"${req.method()} ${req.path()}\" ${status} ${elapsed}ms"
        end
        response
      end
    end
  end

  /#
  @summary Serves files from a directory for GET and HEAD requests under a path prefix, passing everything else through. Requests that would leave the directory are passed through as well.
  @param string prefix : The URL prefix, such as `"/assets"`.
  @param string dir : The directory to serve.
  @param hashmap options : `index` names a file to serve for a directory (such as `"index.html"`); `cache_control` sets that header on every file served.
  @return lambda : The middleware.
  #/
  fn static_files(prefix, dir, options = {})
    base = prefix
    base = base[0:base.size() - 1] when base.ends_with("/")
    index = options.get("index")
    cache = options.get("cache_control")
    with (app) do
      with (env) do
        method = env["method"]
        p = env.get("script_name", "") + env.get("path_info", "")
        served = null
        if (method == "GET" || method == "HEAD") && (p.begins_with(base + "/") || (p == base && index != null))
          rel = p[base.size():]
          # The server removes dot segments, but a backslash is a separator on Windows,
          # so refuse anything that could still climb out of the directory.
          if !rel.contains("\\") && !rel.split("/").contains("..")
            fp = dir + rel
            fp = fio::combine([fp, index]) when index != null && fio::isdir(fp)
            served = fp when fio::exists(fp) && !fio::isdir(fp)
          end
        end
        if served == null
          return app(env)
        end
        headers = {"content-type": mime_type(fio::ext(served))}
        headers["cache-control"] = cache when cache != null
        [200, headers, fio::readbytes(served)]
      end
    end
  end

  /#
  @summary Adds CORS headers to every response and answers preflight (`OPTIONS`) requests with `204`.
  @param string origin : The allowed origin (default `"*"`).
  @param hashmap options : `methods` and `headers` override the allowed methods and request headers; `max_age` sets how long a preflight is cached, in seconds.
  @return lambda : The middleware.
  #/
  fn cors(origin = "*", options = {})
    allow = {
      "access-control-allow-origin":  origin,
      "access-control-allow-methods": options.get("methods", "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD"),
      "access-control-allow-headers": options.get("headers", "Content-Type, Authorization, X-Requested-With")
    }
    allow["access-control-max-age"] = options["max_age"].to_string() when options.get("max_age") != null
    allow["vary"] = "Origin" when origin != "*"
    with (app) do
      with (env) do
        return [204, allow.clone(), ""] when env["method"] == "OPTIONS"
        response = app(env)
        if typeof(response) == list && response.size() == 3 && typeof(response[1]) == hashmap
          for k, v in allow do
            response[1][k] = v when !response[1].has_key(k)
          end
        end
        response
      end
    end
  end

  /#
  @summary Gives each request an identifier, stored as `env["web.request_id"]` and sent back in a response header. A well-formed identifier sent by the client (or a proxy) is kept.
  @param string header : The header to read and write (default `"x-request-id"`).
  @return lambda : The middleware.
  #/
  fn request_id(header = "x-request-id")
    name = header.lowercase()
    with (app) do
      with (env) do
        incoming = env.get("headers", {}).get(name)
        valid = incoming != null && incoming.size() <= 128 && incoming.matches('^[A-Za-z0-9._:-]+$')
        id = valid ? incoming : crypto::uuid()
        env["web.request_id"] = id
        response = app(env)
        if typeof(response) == list && response.size() == 3 && typeof(response[1]) == hashmap
          response[1][name] = id
        end
        response
      end
    end
  end

  /#
  @summary Catches errors thrown by the app and turns them into a response. Errors thrown while a streaming body is producing chunks happen after the response has started, so they are not caught here.
  @param lambda handler : Called as `handler(err, env)`; returns a response.
  @return lambda : The middleware.
  #/
  fn rescue(handler)
    with (app) do
      with (env) do
        try
          return app(env)
        catch err
          return handler(err, env)
        end
      end
    end
  end

  /#
  @summary Checks that requests and responses follow the web interface, and throws a descriptive error when they don't. Use it in development and tests, between the app and everything else.
  @return lambda : The middleware.
  #/
  fn lint()
    with (app) do
      with (env) do
        problem = _check_env(env)
        throw error::ValueError("web::lint: ${problem}") when problem != null
        response = app(env)
        problem = check_response(response)
        throw error::ValueError("web::lint: ${problem}") when problem != null
        response
      end
    end
  end

  fn _check_env(env)
    return "env must be a hashmap, got ${typeof(env)}" when typeof(env) != hashmap
    for key in ["method", "script_name", "path_info", "query_string", "headers", "body"] do
      return "env is missing \"${key}\"" when !env.has_key(key)
    end
    return "env[\"method\"] must be an uppercase string" when typeof(env["method"]) != string || env["method"] != env["method"].uppercase()
    sn = env["script_name"]
    pi = env["path_info"]
    return "env[\"script_name\"] must be \"\" or start with \"/\"" when sn != "" && !sn.begins_with("/")
    return "env[\"script_name\"] must not end with \"/\"" when sn.ends_with("/")
    return "env[\"path_info\"] must be \"\" or start with \"/\"" when pi != "" && !pi.begins_with("/")
    return "env[\"headers\"] must be a hashmap" when typeof(env["headers"]) != hashmap
    for k, v in env["headers"] do
      return "request header names must be lowercase, got \"${k}\"" when k != k.lowercase()
    end
    return "env[\"body\"] must be bytes" when typeof(env["body"]) != bytes
    null
  end

  /#
  @summary Checks a value against the response format: `[status, headers, body]` with an integer status from 100 to 999, a hashmap of lowercase header names to strings (or lists of strings), and a body that is a string, bytes, a list of strings or bytes, a generator, or a lambda. Status 1xx, 204 and 304 responses must have an empty body.
  @param any response : The value an app returned.
  @return string : A description of the first problem, or `null` when it is valid.
  #/
  fn check_response(response)
    return "a response must be a list [status, headers, body], got ${typeof(response)}" when typeof(response) != list
    return "a response must have 3 elements [status, headers, body], got ${response.size()}" when response.size() != 3
    status = response[0]
    headers = response[1]
    body = response[2]
    return "status must be an integer, got ${typeof(status)}" when typeof(status) != integer
    return "status must be from 100 to 999, got ${status}" when status < 100 || status > 999
    return "headers must be a hashmap, got ${typeof(headers)}" when typeof(headers) != hashmap
    for k, v in headers do
      return "header names must be strings, got ${typeof(k)}" when typeof(k) != string
      return "header names must be lowercase, got \"${k}\"" when k != k.lowercase()
      return "header \"${k}\" contains a line break" when k.contains("\n") || k.contains("\r")
      values = typeof(v) == list ? v : [v]
      for item in values do
        return "header \"${k}\" must be a string or a list of strings, got ${typeof(item)}" when typeof(item) != string
        return "header \"${k}\" contains a line break" when item.contains("\n") || item.contains("\r")
      end
    end
    kind = typeof(body)
    allowed = body == null || kind == string || kind == bytes || kind == list || kind == generator || kind == lambda
    return "body must be a string, bytes, list, generator or lambda, got ${kind}" when !allowed
    if (status < 200 || status == 204 || status == 304) && body != null && body != "" && !(kind == list && body.size() == 0)
      return "a ${status} response must not have a body" when kind == string || kind == bytes || kind == list
    end
    null
  end

  # ---------------------------------------------------------------------------
  # Delivering a response
  # ---------------------------------------------------------------------------

  /#
  @summary Calls an app and drains its response body in one place, for servers and the test client. `sink` receives each chunk (string or bytes) and returns `false` to stop a streaming body early.
  #/
  fn _drain(body, sink)
    kind = typeof(body)
    if body == null
      return
    elsif kind == string || kind == bytes
      sink(body)
    elsif kind == list
      for chunk in body do
        break when !sink(_chunk(chunk))
      end
    elsif kind == generator
      for chunk in body do
        break when !sink(_chunk(chunk))
      end
    elsif kind == lambda
      body(with (chunk) do sink(_chunk(chunk)) end)
    else
      sink(body.to_string())
    end
  end

  fn _chunk(chunk)
    kind = typeof(chunk)
    kind == string || kind == bytes ? chunk : chunk.to_string()
  end

  fn _is_streaming(body)
    kind = typeof(body)
    kind == generator || kind == lambda
  end

  fn _buffer(body)
    kind = typeof(body)
    return body when kind == string || kind == bytes
    return "" when body == null
    parts = []
    _drain(body, with (chunk) do
      parts.push(chunk)
      true
    end)
    has_bytes = false
    for p in parts do
      has_bytes = true when typeof(p) == bytes
    end
    return parts.join("") when !has_bytes
    out = "".to_bytes()
    for p in parts do
      out += typeof(p) == bytes ? p : p.to_bytes()
    end
    out
  end

  fn _log_error(err, env)
    method = env.get("method", "?")
    path = env.get("script_name", "") + env.get("path_info", "")
    message = typeof(err) == hashmap ? "${err.get("error", "Error")}: ${err.get("message", "")}" : err.to_string()
    eprintln "[web] ${method} ${path} failed: ${message}"
  end

  # ---------------------------------------------------------------------------
  # Server
  # ---------------------------------------------------------------------------

  /#
  @summary Runs an app on an HTTP server (Kestrel). Each request gets its own task and its own environment.
  #/
  struct Server
    /#
    @summary Creates a server for an app. Nothing listens until `start`.
    @param any app : The app.
    @param hashmap options : `host` (default `"localhost"`), `port` (default `8080`), `workers` (handlers running at once, default `64`), `max_body_size` (bytes, default 8 MiB) and `request_timeout` (milliseconds to start a response, default `30000`).
    #/
    fn new(app, options = {})
      @app     = app
      @host    = options.get("host", "localhost")
      @port    = options.get("port", 8080)
      @limits  = {
        "max_in_flight":      options.get("workers", 64),
        "max_body_size":      options.get("max_body_size", 8 * 1024 * 1024),
        "request_timeout_ms": options.get("request_timeout", 30000)
      }
      @poll_ms = options.get("poll_ms", 1000)
      @id      = null
      @running = false
    end

    /#
    @summary Starts listening.
    @param boolean block : If `true`, serves on the calling task until `stop()`; otherwise serves on a background task and returns at once.
    @return Server : self
    #/
    fn start(block = false)
      @id      = __httpserver_create__(@host, @port, @limits)
      @running = true
      serve_loop = with (_srv) do
        while _srv.running() do
          raw = __httpserver_accept__(_srv.id(), _srv.poll_ms())
          next when raw == null
          task::detach(with (_s, _r) do _s.handle(_r) end, [_srv, raw])
        end
      end
      if block
        serve_loop(@)
      else
        task::spawn(serve_loop, [@])
      end
      @
    end

    /#
    @summary Stops listening. Requests still waiting on the app are answered with `503`.
    @return Server : self
    #/
    fn stop()
      @running = false
      __httpserver_stop__(@id) when @id != null
      @
    end

    /#
    @summary Checks whether the server is listening.
    @return boolean
    #/
    fn running()  @running end

    /#
    @summary Returns the server's internal identifier.
    @return integer
    #/
    fn id()       @id end

    /#
    @summary Returns the accept-poll interval in milliseconds.
    @return integer
    #/
    fn poll_ms()  @poll_ms end

    # Handles one request from the transport on its own task: builds the environment,
    # calls the app and sends what it returns.
    private fn handle(raw)
      env = {
        "method":       raw["method"],
        "script_name":  "",
        "path_info":    raw["path"],
        "query_string": raw["query_string"],
        "headers":      raw["headers"],
        "body":         raw["body"],
        "remote_addr":  raw["remote_addr"],
        "scheme":       raw["scheme"],
        "protocol":     raw["protocol"],
        "server_name":  @host,
        "server_port":  @port,
        "web.version":  VERSION
      }
      rid = raw["id"]

      response = null
      try
        response = @app(env)
      catch err
        _log_error(err, env)
        __httpserver_respond__(@id, rid, 500, {"content-type": "text/plain; charset=utf-8"}, "Internal Server Error")
        return
      end

      problem = check_response(response)
      if problem != null
        eprintln "[web] ${env["method"]} ${env["path_info"]}: invalid response: ${problem}"
        __httpserver_respond__(@id, rid, 500, {"content-type": "text/plain; charset=utf-8"}, "Internal Server Error")
        return
      end

      status  = response[0]
      headers = response[1]
      body    = response[2]

      if !_is_streaming(body)
        payload = null
        try
          payload = _buffer(body)
        catch err
          _log_error(err, env)
          __httpserver_respond__(@id, rid, 500, {"content-type": "text/plain; charset=utf-8"}, "Internal Server Error")
          return
        end
        __httpserver_respond__(@id, rid, status, headers, payload)
        return
      end

      return when !__httpserver_stream__(@id, rid, status, headers)
      failed = false
      try
        _drain(body, with (chunk) do __httpserver_write__(rid, chunk) end)
      catch err
        failed = true
        _log_error(err, env)
      finally
        __httpserver_end__(rid, failed)
      end
    end
  end

  /#
  @summary Runs an app on an HTTP server and blocks until it stops.
  @param any app : The app.
  @param hashmap options : The server options; see `Server.new`.
  @return Server : The stopped server.
  #/
  fn serve(app, options = {})
    Server.new(app, options).start(true)
  end

  # ---------------------------------------------------------------------------
  # Test client
  # ---------------------------------------------------------------------------

  /#
  @summary Builds an environment for calling an app directly, without a server.
  @param string method : The HTTP method.
  @param string path : The path, optionally with a query string (`"/search?q=kiwi"`).
  @param hashmap options : `headers` (a hashmap), `body` (a string, bytes, or a hashmap sent as JSON), `remote_addr` and `script_name`.
  @return hashmap : The environment.
  #/
  fn mock_env(method, path, options = {})
    qs = ""
    q = path.index("?")
    if q >= 0
      qs = path[q + 1:]
      path = path[0:q]
    end
    headers = {}
    for k, v in options.get("headers", {}) do
      headers[k.lowercase()] = v.to_string()
    end
    body = options.get("body")
    if typeof(body) == hashmap || typeof(body) == list
      body = serialize(body)
      headers["content-type"] = "application/json" when !headers.has_key("content-type")
    end
    body = "" when body == null
    body = body.to_bytes() when typeof(body) == string
    headers["host"] = "localhost" when !headers.has_key("host")
    {
      "method":       method.uppercase(),
      "script_name":  options.get("script_name", ""),
      "path_info":    path,
      "query_string": qs,
      "headers":      headers,
      "body":         body,
      "remote_addr":  options.get("remote_addr", "127.0.0.1"),
      "scheme":       "http",
      "protocol":     "HTTP/1.1",
      "server_name":  "localhost",
      "server_port":  80,
      "web.version":  VERSION
    }
  end

  /#
  @summary Calls an app with a mock request and collects its response, streaming bodies included. Errors thrown by the app propagate, so tests see them.
  @param any app : The app.
  @param string method : The HTTP method.
  @param string path : The path, optionally with a query string.
  @param hashmap options : As for `mock_env`.
  @return MockResponse : The response.
  #/
  fn request(app, method, path, options = {})
    response = app(mock_env(method, path, options))
    problem = check_response(response)
    throw error::ValueError("web::request: invalid response: ${problem}") when problem != null
    body = _buffer(response[2])
    body = body.to_bytes() when typeof(body) == string
    MockResponse.new(response[0], response[1], body)
  end

  /#
  @summary The response collected by `web::request`.
  #/
  struct MockResponse
    fn new(status, headers, body)
      @status  = status
      @headers = headers
      @raw     = body
    end

    /#
    @summary Returns the status code.
    @return integer
    #/
    fn status()      @status end

    /#
    @summary Returns the response headers.
    @return hashmap
    #/
    fn headers()     @headers end

    /#
    @summary Returns a response header (case-insensitive), or `null`. A header sent more than once is a list.
    @param string name : The header name.
    @return any
    #/
    fn header(name)  @headers.get(name.lowercase()) end

    /#
    @summary Returns the body as text.
    @return string
    #/
    fn body()        @raw.to_string() end

    /#
    @summary Returns the body as bytes.
    @return bytes
    #/
    fn body_bytes()  @raw end

    /#
    @summary Returns the body parsed as JSON.
    @return any
    #/
    fn json()        deserialize(@raw.to_string()) end
  end

end
