@tester::test("task: interval stops")
fn test_task_interval()
  n = [0]
  counting = task::interval(1, do ()
    n[0] += 1
    n[0] < 3
  end)
  task::await(counting.id())
  tester::assert_eq(n[0], 3, "returning false stops an interval")

  ticks = [0]
  heartbeat = task::interval(1, do () => ticks[0] += 1)
  task::sleep(20)
  heartbeat.stop()
  task::await(heartbeat.id())
  stopped_at = ticks[0]
  task::sleep(10)
  tester::assert_eq(ticks[0], stopped_at, "stop() ends an interval")
end

@tester::test("task: mutex")
fn test_task_mutex()
  m = task::mutex()
  tester::assert_eq(m.synchronize(do () => 42), 42)
  tester::assert(m.try_acquire())
  m.release()
end

@tester::test("task: detach runs work that nothing awaits and forgets it")
fn test_task_detach()
  done = task::channel(10)
  before = task::list().size()
  for i in [1 to 5] do
    task::detach(do (c, n) => c.send(n * 2), [done, i])
  end
  got = []
  repeat 5 do got.push(done.recv()) end
  tester::assert_eq(got.sort(), [2, 4, 6, 8, 10])

  # Finished detached tasks leave nothing behind to await.
  waited = 0
  while task::list().size() > before && waited < 1000 do
    task::sleep(10)
    waited += 10
  end
  tester::assert_eq(task::list().size(), before)

  # An error inside a detached task is reported on stderr, not lost.
  r = sys::execout(env::bin(), ["-e", "task::detach(do () => throw \"lost?\")\ntask::sleep(200)"])
  tester::assert(r["stderr"].contains("a detached task failed: lost?"), r["stderr"])
end
