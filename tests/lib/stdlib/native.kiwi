# Builds tests/native/kiwi_test_ext.c with the first C compiler found and loads it. Without
# a compiler the extension tests pass without running.
fn _native_build_ext(): string
  root = fio::parentdir(env::lib())
  out  = fio::combine([fio::tmpdir(), "kiwi_native_test_${sys::pid()}", native::library_name("kiwi_test_ext")])
  fio::mkdirp(fio::parentdir(out))
  src  = fio::combine([root, "tests", "native", "kiwi_test_ext.c"])
  inc  = fio::combine([root, "sdk", "c"])
  # clang targeting MSVC rejects -fPIC, and Windows DLLs don't need it.
  flags = native::rid().begins_with("win") ? ["-shared"] : ["-shared", "-fPIC"]

  for compiler in ["cc", "clang", "gcc"] do
    try
      r = sys::execout(compiler, flags + ["-I", inc, src, "-o", out])
      return out when r["exit_code"] == 0
    catch
    end
  end
  fio::rmdirf(fio::parentdir(out))
  ""
end

var (_native_ext_path: string = _native_build_ext())

if !_native_ext_path.empty()
  native::load(_native_ext_path, "native_test")
  # Loading again is a no-op, so the build directory can go once the library is mapped.
  # Windows keeps a loaded DLL locked, so the directory stays there.
  try
    fio::rmdirf(fio::parentdir(_native_ext_path))
  catch
  end
end

fn _native_ready(): boolean
  !_native_ext_path.empty()
end

# CI runners have a C compiler, so a skipped build there means lost coverage, not a missing tool.
@tester::test("native: the test extension builds in CI")
fn test_native_builds_in_ci()
  return when env::get("CI") != "true"
  tester::assert(_native_ready(), "no C compiler (cc, clang or gcc) could build tests/native/kiwi_test_ext.c")
end

@tester::test("native: rid() names the current platform")
fn test_native_rid()
  parts = native::rid().split("-")
  tester::assert_eq(parts.size(), 2)
  tester::assert(["linux", "osx", "win", "freebsd"].contains(parts[0]), "unexpected OS in rid")
end

@tester::test("native: library_name() follows platform conventions")
fn test_native_library_name()
  name = native::library_name("foo")
  tester::assert(["libfoo.so", "libfoo.dylib", "foo.dll"].contains(name), "unexpected library name ${name}")
end

@tester::test("native: load() reports a missing library")
fn test_native_load_missing()
  kind = ""
  try
    native::load("kiwi_no_such_library.so")
  catch (k, m)
    kind = k
  end
  tester::assert_eq(kind, "NativeError")
end

@tester::test("native: functions take and return scalars")
fn test_native_scalars()
  return when !_native_ready()
  tester::assert_eq(native_test::add(2, 3), 5)
  tester::assert_eq(native_test::add(2.5, 1), 3.5)
  tester::assert_eq(native_test::reverse("kiwi"), "iwik")
  tester::assert_eq(native_test::nothing(), null)
end

@tester::test("native: load() returns a package reference")
fn test_native_package_ref()
  return when !_native_ready()
  m = native::load(_native_ext_path, "native_test")
  tester::assert_eq(m.add(20, 22), 42)
end

@tester::test("native: variadic functions get every argument")
fn test_native_variadic()
  return when !_native_ready()
  tester::assert_eq(native_test::sum(), 0)
  tester::assert_eq(native_test::sum(1, 2, 3, 4), 10)
end

@tester::test("native: lists and hashmaps cross the boundary")
fn test_native_collections()
  return when !_native_ready()
  tester::assert_eq(native_test::squares([1, 2, 3]), [1, 4, 9])
  d = native_test::describe({"name": "kiwi", "age": 3})
  tester::assert_eq(d["has_name"], true)
  tester::assert_eq(d["keys"], ["name", "age"])
end

@tester::test("native: bytes and pointers round-trip")
fn test_native_bytes_pointers()
  return when !_native_ready()
  tester::assert_eq(native_test::bytes_xor(native_test::bytes_xor("abc".to_bytes(), 7), 7).to_string(), "abc")
  p = native_test::counter_ptr()
  first = native_test::counter_bump(p)
  tester::assert_eq(native_test::counter_bump(p), first + 1)
end

@tester::test("native: native code can call Kiwi lambdas")
fn test_native_callback()
  return when !_native_ready()
  tester::assert_eq(native_test::apply(with (a, b) do return a * b end, 6, 7), 42)
end

@tester::test("native: raise() becomes a NativeError")
fn test_native_raise()
  return when !_native_ready()
  kind = ""
  msg  = ""
  try
    native_test::fail("boom")
  catch (k, m)
    kind = k
    msg  = m
  end
  tester::assert_eq(kind, "NativeError")
  tester::assert_eq(msg, "boom")
end

@tester::test("native: wrong argument types and counts are errors")
fn test_native_argument_errors()
  return when !_native_ready()
  kinds = []
  try native_test::add("x", 1) catch (k, m) kinds.push(k) end
  try native_test::add(1) catch (k, m) kinds.push(k) end
  tester::assert_eq(kinds, ["NativeError", "ParameterCountMismatchError"])
end

@tester::test("native: errors thrown by a callback propagate")
fn test_native_callback_error()
  return when !_native_ready()
  msg = ""
  try
    native_test::apply(with () do throw "from kiwi" end)
  catch (k, m)
    msg = m
  end
  tester::assert_eq(msg, "from kiwi")
end

@tester::test("native: functions can be called from tasks")
fn test_native_tasks()
  return when !_native_ready()
  tids = [1 to 4].map(with (n) do
    return task::spawn(with (x) do
      return native_test::sum(x, x, x)
    end, [n])
  end)
  tester::assert_eq(tids.map(with (t) do return task::await(t) end), [3, 6, 9, 12])
end
