/# ==============================================================================
   Testing every kind of loop available in kiwi: `for`, `while`, `repeat`
  ============================================================================== #/
@tester::test("loops")
fn test_loops()
  fruits = ["kiwi", "strawberry", "pineapple", "lime", "mango", "guava"]
  new_list = []

  # iterate list
  for fruit in fruits do
    new_list.push(fruit)
  end

  tester::assert(new_list.join() == "kiwistrawberrypineapplelimemangoguava", "A1")
  new_list.clear()

  # iterate index
  for fruit, index in fruits do
    new_list.push(index)
  end

  tester::assert(new_list.sum() == 15, "A2")
  new_list.clear()

  # iterate inline list
  for item in ["kiwi", "is", "fun"] do
    new_list.push(item)
  end

  tester::assert(new_list.join() == "kiwiisfun", "A3")
  new_list.clear()

  # iterate an inline list with an index
  for item, index in ["kiwi", "is", "fun"] do
    new_list.push(index)
  end

  tester::assert(new_list.sum() == 3 and new_list.size() == 3, "A4")
  new_list.clear()

  # iterate a range
  for i in [0 to 5] do
    new_list.push(i)
  end

  tester::assert(new_list.size() == 6 and new_list.sum() == 15, "A5")
  new_list.clear()

  # nested while loops
  var (test_sum: integer = 0)
  i = 0
  j = 0
  while i < 10 do
    i += 1
    j = 0

    while j < 10 do
      j += 1
      test_sum += 1
    end
  end

  tester::assert(test_sum == 100, "A7")

  new_list = []
  i = 1
  while i <= 10 do
    new_list.push("Item ${i}")
    i += 1
  end

  counter = 0
  for item, index in new_list do
    counter += 1
    break when index == 4
  end

  tester::assert(counter == 5, "A8")

  counter = 0
  for item, index in new_list do
    counter += 1
    break when index == 5
  end

  tester::assert(counter == 6, "A9")

  # repeat-loop
  sum = 0
  repeat 10 as i do
    sum += i
  end

  tester::assert(sum == 55, "A10")

  x = 2
  repeat 4 do
    x *= x
  end

  tester::assert(x == 65536, "A11")
end

@tester::test("loops: for over a range literal")
fn test_for_range()
  # `for x in [a to b]` counts instead of building the list; it must yield
  # exactly what the list would.
  out = []
  for i in [1 to 5] do out.push(i) end
  tester::assert(out == [1, 2, 3, 4, 5], "R1: ascending")

  out = []
  for i in [5 to 1] do out.push(i) end
  tester::assert(out == [5, 4, 3, 2, 1], "R2: descending")

  out = []
  for i in [3 .. 3] do out.push(i) end
  tester::assert(out == [3], "R3: single element")

  out = []
  for v, i in [10 to 8] do out.push("${i}:${v}") end
  tester::assert(out == ["0:10", "1:9", "2:8"], "R4: value and index")

  out = []
  for i in [1 to 10] do
    next when i % 2 == 0
    break when i > 7
    out.push(i)
  end
  tester::assert(out == [1, 3, 5, 7], "R5: next and break")

  # Bounds are evaluated once, before the loop starts.
  n = 2
  out = []
  for i in [0 to n] do
    n = 100
    out.push(i)
  end
  tester::assert(out == [0, 1, 2], "R6: bounds evaluated once")

  # A huge bound costs nothing when the loop exits early (the list
  # version allocated every element first).
  hit = 0
  for i in [1 to 10000000] do
    hit = i
    break when i * i > 50
  end
  tester::assert(hit == 8, "R7: early exit from a huge range")

  caught = false
  try
    for i in [1 to 2.5] do end
  catch (err)
    caught = true
  end
  tester::assert(caught, "R8: non-integer bounds throw")
end
