/# ==============================================================================
  Testing lexical scoping: inner function calls must not clobber the caller's
  local variables, and recursion must work correctly.
 ============================================================================== #/
@tester::test("scoping")
fn test_scoping()
  # Two structs with identically-named locals — must not interfere
  struct ScopeA
    fn new(v)
      @v = v
    end
    fn compute()
      x = "from_A_${@v}"
      b = ScopeB.new("b1")
      result = b.compute()
      # x must still be from_A, not clobbered by b.compute()
      "${x}|${result}"
    end
  end

  struct ScopeB
    fn new(v)
      @v = v
    end
    fn compute()
      x = "from_B_${@v}"
      x
    end
  end

  tester::assert(ScopeA.new("a1").compute() == "from_A_a1|from_B_b1", "A1: cross-struct local isolation")

  # Recursive struct method — each call gets fresh locals
  struct Fib
    fn new() end
    fn calc(n)
      if n <= 1
        return n
      end
      Fib.new().calc(n - 1) + Fib.new().calc(n - 2)
    end
  end

  tester::assert(Fib.new().calc(0) == 0,  "A2: fib(0)")
  tester::assert(Fib.new().calc(1) == 1,  "A3: fib(1)")
  tester::assert(Fib.new().calc(7) == 13, "A4: fib(7)")
  tester::assert(Fib.new().calc(10) == 55, "A5: fib(10)")

  # Instance vars remain per-object across nested serialize calls
  struct SNode
    fn new(val, child)
      @val = val
      @child = child
    end
    fn serialize()
      @_buf = "v=${@val}"
      child_str = ""
      if @child != null
        child_str = @child.serialize()
      end
      "${@_buf}[${child_str}]"
    end
  end

  leaf = SNode.new("leaf", null)
  mid  = SNode.new("mid",  leaf)
  root = SNode.new("root", mid)
  tester::assert(root.serialize() == "v=root[v=mid[v=leaf[]]]", "A6: instance var isolation across recursive calls")

  # Package-level function: caller's locals not visible in callee
  package scoping_test_pkg
    fn inner()
      result = "inner_result"
      result
    end
    fn outer()
      result = "outer_result"
      inner_val = scoping_test_pkg::inner()
      "${result}|${inner_val}"
    end
  end
  export "scoping_test_pkg"

  tester::assert(scoping_test_pkg::outer() == "outer_result|inner_result", "A7: package function local isolation")

  # Top-level function recursion: each activation gets its own locals
  fn countdown(n)
    if n == 0
      return "done"
    end
    prefix = "n=${n}"
    rest = countdown(n - 1)
    # prefix must still be "n=${n}", not clobbered by inner call
    "${prefix}:${rest}"
  end

  tester::assert(countdown(3) == "n=3:n=2:n=1:done", "A8: top-level recursive function isolation")
end

fn _scope_try_local(n)
  try
    mine = n
    _scope_try_local(n - 1) when n > 0
  catch (e)
  end
  mine
end

fn _scope_case_local(n)
  case n
    when 1
      picked = "one"
    else
      picked = "other"
  end
  picked
end

fn _scope_const_in_block()
  const LIMIT = 3
  if true
    try
      LIMIT = 9
    catch (e)
    end
  end
  LIMIT
end

@tester::test("scoping: assignments in try and case blocks are function locals")
fn test_scoping_block_locals()
  tester::assert_eq(_scope_try_local(2), 2, "a recursive call keeps its own try-block local")
  tester::assert_eq(_scope_case_local(1), "one")
  tester::assert_eq(_scope_case_local(2), "other")

  leaked = []
  try
    mine
  catch (e)
    leaked.push("mine")
  end
  try
    picked
  catch (e)
    leaked.push("picked")
  end
  tester::assert_eq(leaked, ["mine", "picked"], "block locals don't leak into the global scope")

  tester::assert_eq(_scope_const_in_block(), 3, "an assignment in a block still hits the constant")
end

# A lambda shares a variable it assigns with the enclosing function only if the function
# assigned it before the lambda. Reads are unchanged.
@tester::test("scoping: a lambda's assignment shares only variables assigned before it")
fn test_lambda_capture_order()
  lam = do ()
    later = "lambda"
    later
  end
  tester::assert_eq(lam(), "lambda")
  later = "function"
  lam()
  tester::assert_eq(later, "function", "the lambda's `later` is its own")

  count = 0
  [1 to 3].each(do (n) => count += n)
  tester::assert_eq(count, 6, "a variable assigned first is shared")

  flag = false
  set_flag = do () => flag = true
  set_flag()
  tester::assert_eq(flag, true, "plain assignment to an earlier variable is shared")
end

@tester::test("scoping: reads still see variables assigned after the lambda")
fn test_lambda_forward_reads()
  fact = do (n) => n <= 1 ? 1 : n * fact(n - 1)
  is_even = do (n) => n == 0 ? true : is_odd(n - 1)
  is_odd = do (n) => n == 0 ? false : is_even(n - 1)
  tester::assert_eq(fact(5), 120)
  tester::assert_eq(is_even(10), true)

  show = do () => "value=${value}"
  value = 42
  tester::assert_eq(show(), "value=42")
end

@tester::test("scoping: var in a lambda declares the lambda's own variable")
fn test_lambda_var_local()
  x = "outer"
  lam = do ()
    var x = "lambda"
    x
  end
  tester::assert_eq(lam(), "lambda")
  tester::assert_eq(x, "outer")
end

@tester::test("scoping: nested lambdas follow the same order")
fn test_nested_lambda_capture_order()
  outer = do ()
    inner = do () => shared = "inner"
    inner()
    shared
  end
  tester::assert_eq(outer(), null, "inner's `shared` is its own")
  shared = "function"
  outer()
  tester::assert_eq(shared, "function")

  total = 0
  add = do (n)
    bump = do () => total += n
    bump()
  end
  add(2)
  add(3)
  tester::assert_eq(total, 5, "a variable assigned before both lambdas is shared")
end

@tester::test("scoping: a task's variables don't collide with the spawner's")
fn test_task_capture_order()
  ready = task::channel()
  go = task::channel()
  worker = task::spawn(do (r, g)
    tid = "worker"
    r.send(true)
    g.recv()        # the spawner assigns its own `tid` meanwhile
    tid
  end, [ready, go])

  ready.recv()
  tid = "spawner"
  go.send(true)
  tester::assert_eq(task::await(worker), "worker")
  tester::assert_eq(tid, "spawner")
end

@tester::test("scoping: a top-level lambda shares only globals assigned before it")
fn test_top_level_lambda_capture_order()
  script = fio::combine([fio::tmpdir(), "kiwi_scoping_${sys::pid()}.kiwi"])
  fio::write(script, "earlier = \"script\"\nset_earlier = do () => earlier = \"lambda\"\nset_later = do () => later = \"lambda\"\nlater = \"script\"\nset_earlier()\nset_later()\nprintln [earlier, later]\n")
  try
    r = sys::execout(env::bin(), [script])
    tester::assert_eq(r["stdout"].trim(), "[\"lambda\", \"script\"]", r["stderr"])
  finally
    fio::remove(script)
  end
end
