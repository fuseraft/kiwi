/#==============================================================================
  Testing task spawning with struct methods that access @attr and call builtins.
  This exercises the VM/interpreter boundary inside spawned task threads.
 ==============================================================================#/
require "task"

@tester::test("tasks: struct methods inside spawned tasks")
fn test_tasks_struct()
  struct Accumulator
    fn new()
      @total = 0
      @items = []
    end

    fn add(n)
      @total += n
      @items.push(n)
    end

    fn total() @total end
    fn count() @items.size() end

    fn summary()
      # builtins on @attr inside struct method — key VM fallback path
      mean = @total.to_float() / @items.size()
      "${@items.size()} items, total=${@total}, mean=${mean}"
    end
  end

  # A1: struct ops inside a spawned task return the correct value
  id = task::spawn(with () do
    acc = Accumulator.new()
    for i in [1 to 10] do
      acc.add(i)
    end
    [acc.total(), acc.count(), acc.summary()]
  end, [])

  result = await(id)
  tester::assert(result[0] == 55,                             "A1: total")
  tester::assert(result[1] == 10,                             "A2: count")
  tester::assert(result[2] == "10 items, total=55, mean=5.5", "A3: summary: ${result[2]}")

  # A4-A6: multiple tasks with independent struct instances don't share state
  ids = []
  for n in [10, 20, 30] do
    tid = task::spawn(with (limit) do
      acc = Accumulator.new()
      for i in [1 to limit] do
        acc.add(i)
      end
      acc.total()
    end, [n])
    ids.push(tid)
  end

  totals = []
  for tid in ids do
    totals.push(await(tid))
  end

  tester::assert(totals[0] == 55,  "A4: task 0 total (1..10)")
  tester::assert(totals[1] == 210, "A5: task 1 total (1..20)")
  tester::assert(totals[2] == 465, "A6: task 2 total (1..30)")

  # A7: channel-based communication with struct method inside task
  ch = task::channel()

  task::spawn(with (c) do
    acc = Accumulator.new()
    acc.add(3)
    acc.add(7)
    acc.add(10)
    c.send(acc.summary())
    c.close()
  end, [ch])

  msg = ch.recv()
  tester::assert(msg == "3 items, total=20, mean=6.666666666666667", "A7: channel msg: ${msg}")
end

@tester::test("tasks: concurrent list lambdas don't share a call stack")
fn test_tasks_concurrent_list_lambdas()
  # Each task has its own call stack; before this, concurrent .map() calls
  # pushed/popped a shared stack and failed with "Stack empty."
  ids = []
  for k in [1 to 16] do
    ids.push(task::spawn(with (n) do
      t = 0
      for i in [1 to 500] do
        t += [1, 2, 3].map(with (y) do y + i end).sum()
      end
      t
    end, [k]))
  end

  ok = true
  for tid in ids do
    if await(tid) != 378750
      ok = false
    end
  end

  tester::assert(ok, "B1: every concurrent task computes its own map/sum")
end

@tester::test("tasks: shared collections and objects stay consistent")
fn test_tasks_shared_state()
  struct SharedBag
    fn new()
      @items  = []
      @fields = {}
    end

    fn put(k, v)
      @items.push(v)
      @fields[k] = v
    end

    fn count() @items.size() end
    fn field_count() @fields.keys().size() end
  end

  # Unsynchronized writes from many tasks used to corrupt these collections.
  shared = []
  bag    = SharedBag.new()
  m      = {}

  ids = []
  for k in [1 to 8] do
    ids.push(task::spawn(with (n) do
      for i in [1 to 500] do
        shared.push(i)
        bag.put("f_${n}_${i % 20}", i)
        m["${n}:${i}"] = i
      end
      n
    end, [k]))
  end
  for tid in ids do await(tid) end

  tester::assert(shared.size() == 4000,        "C1: list pushes: ${shared.size()}")
  tester::assert(bag.count() == 4000,          "C2: object list pushes: ${bag.count()}")
  tester::assert(bag.field_count() == 160,     "C3: object hashmap keys: ${bag.field_count()}")
  tester::assert(m.keys().size() == 4000,      "C4: hashmap keys: ${m.keys().size()}")
end
