@tester::test("byte strings")
fn test_byte_strings()
  # Basic empty bytes
  empty_bytes = b""
  tester::assert(empty_bytes.size() == 0, "expected empty bytes")

  # Non-ASCII should fail (enforces ASCII-only in bytestrings)
  err_c = 0
  try
    bad = b"café"   # 'é' is 233 > 127
    err_c = -1
  catch (e)
    err_c = 1
  end

  tester::assert(err_c == 1, "expected ascii-only bytestring")

  # Comparison with old ways
  hello = b"hello"
  old_way_str = "hello".to_bytes()
  old_way_list = [104, 101, 108, 108, 111].to_bytes()

  tester::assert(hello == old_way_str, "bytestring did not match expected value")
  tester::assert(hello == old_way_list, "bytestring did not match expected value")
end

@tester::test("bytestrings: + concatenates bytes")
fn test_bytes_concat()
  joined = "ab".to_bytes() + [0, 255].to_bytes()
  tester::assert(typeof(joined) == bytes, "expected bytes")
  tester::assert(joined.to_list() == [97, 98, 0, 255], "expected the bytes in order")

  acc = b""
  for chunk in ["x".to_bytes(), "y".to_bytes()] do
    acc += chunk
  end
  tester::assert(acc.to_string() == "xy", "expected += to append")
end
