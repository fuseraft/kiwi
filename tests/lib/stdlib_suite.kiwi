package stdlib_suite
  fn __version__()
    "1.0.0"
  end
end

var (stdlib_tests: list = [
  # Command-line parsing
  "cli",

  # Encoding utilities
  "encode",

  # Hashing
  "crypto",

  # String formatting
  "fmt",

  # Math
  "math",

  # Strings
  "string",

  # Tasks
  "task",

  # Reflection, paths and package name resolution
  "runtime",

  # Statistics
  "stat",

  # Templating
  "template",

  # Logging
  "log",

  # OS signals
  "signal",

  # UDP networking
  "udp",

  # HTTP client responses
  "http",

  # HTTP server
  "httpserver",

  # Filesystem watching
  "watch",

  # Native extensions
  "native"
])

for stdlib_test in stdlib_tests do
  include "stdlib/${stdlib_test}"
end

export "stdlib_suite"
